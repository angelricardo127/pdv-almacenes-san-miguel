<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" style="-fx-padding: 30; -fx-background-color: white; -fx-font-family: 'Segoe UI', sans-serif;" prefWidth="650.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.asm.controlador.FormularioProductoController">

    <Label text="📦 Registrar Nuevo Producto" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2D3748;">
        <VBox.margin>
            <Insets bottom="10.0" />
        </VBox.margin>
    </Label>

    <GridPane hgap="25.0" vgap="18.0">
        <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
        </columnConstraints>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Código SKU" style="-fx-text-fill: #718096; -fx-font-size: 13px;"/>
            <TextField fx:id="txtSku" promptText="Ej: UNI-PAN-001" style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #E2E8F0; -fx-border-radius: 5; -fx-font-size: 14px; -fx-prompt-text-fill: #A0AEC0;"/>
        </VBox>
        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <HBox spacing="2">
                <Label text="Nombre del Producto" style="-fx-text-fill: #718096; -fx-font-size: 13px;"/>
                <Label text="*" style="-fx-text-fill: #E53E3E; -fx-font-weight: bold; -fx-font-size: 14px;"/>
            </HBox>
            <TextField fx:id="txtNombre" promptText="Ej: Pantalón de Gala Hombre" style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #E2E8F0; -fx-border-radius: 5; -fx-font-size: 14px; -fx-prompt-text-fill: #A0AEC0;"/>
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <HBox spacing="2">
                <Label text="Categoría" style="-fx-text-fill: #718096; -fx-font-size: 13px;"/>
                <Label text="*" style="-fx-text-fill: #E53E3E; -fx-font-weight: bold; -fx-font-size: 14px;"/>
            </HBox>
            <ComboBox fx:id="cmbCategoria" promptText="Seleccionar categoría..." style="-fx-padding: 8; -fx-background-radius: 5; -fx-border-color: #E2E8F0; -fx-border-radius: 5; -fx-font-size: 14px; -fx-prompt-text-fill: #A0AEC0;" prefWidth="1000.0"/>
        </VBox>
        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Variantes (Tallas/Colores)" style="-fx-text-fill: #718096; -fx-font-size: 13px;"/>
            <TextField fx:id="txtVariantes" promptText="Ej: 28, 30, 32, 34, 36" style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #E2E8F0; -fx-border-radius: 5; -fx-font-size: 14px; -fx-prompt-text-fill: #A0AEC0;"/>
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <HBox spacing="2">
                <Label text="Precio de Venta" style="-fx-text-fill: #718096; -fx-font-size: 13px;"/>
                <Label text="*" style="-fx-text-fill: #E53E3E; -fx-font-weight: bold; -fx-font-size: 14px;"/>
            </HBox>
            <TextField fx:id="txtPrecioVenta" promptText="\$ 0.00" style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #E2E8F0; -fx-border-radius: 5; -fx-font-size: 14px; -fx-prompt-text-fill: #A0AEC0;"/>
        </VBox>
        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Label text="Costo de Compra" style="-fx-text-fill: #718096; -fx-font-size: 13px;"/>
            <TextField fx:id="txtCostoCompra" promptText="\$ 0.00" style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #E2E8F0; -fx-border-radius: 5; -fx-font-size: 14px; -fx-prompt-text-fill: #A0AEC0;"/>
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
            <HBox spacing="2">
                <Label text="Stock Inicial" style="-fx-text-fill: #718096; -fx-font-size: 13px;"/>
                <Label text="*" style="-fx-text-fill: #E53E3E; -fx-font-weight: bold; -fx-font-size: 14px;"/>
            </HBox>
            <TextField fx:id="txtStockInicial" promptText="0" style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #E2E8F0; -fx-border-radius: 5; -fx-font-size: 14px; -fx-prompt-text-fill: #A0AEC0;"/>
        </VBox>
        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
            <Label text="Stock Mínimo (Alerta)" style="-fx-text-fill: #718096; -fx-font-size: 13px;"/>
            <TextField fx:id="txtStockMinimo" promptText="5" style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #E2E8F0; -fx-border-radius: 5; -fx-font-size: 14px; -fx-prompt-text-fill: #A0AEC0;"/>
        </VBox>

        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2">
            <Label text="Proveedor" style="-fx-text-fill: #718096; -fx-font-size: 13px;"/>
            <TextField fx:id="txtProveedor" promptText="Ej: Textiles del Norte S.A." style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #E2E8F0; -fx-border-radius: 5; -fx-font-size: 14px; -fx-prompt-text-fill: #A0AEC0;"/>
        </VBox>
    </GridPane>

    <VBox spacing="6.0">
        <Label text="Descripción (Opcional)" style="-fx-text-fill: #718096; -fx-font-size: 13px;"/>
        <TextArea fx:id="txtDescripcion" promptText="Descripción detallada del producto..." style="-fx-padding: 8; -fx-background-radius: 5; -fx-border-color: #E2E8F0; -fx-border-radius: 5; -fx-font-size: 14px; -fx-prompt-text-fill: #A0AEC0;" prefHeight="100.0" wrapText="true"/>
    </VBox>

    <Region VBox.vgrow="ALWAYS" />

    <HBox alignment="CENTER_RIGHT" spacing="12.0" style="-fx-padding: 10 0 0 0;">
        <Button text="Cancelar" onAction="#cerrarVentana" style="-fx-background-color: white; -fx-border-color: #A0AEC0; -fx-border-radius: 8; -fx-text-fill: #4A5568; -fx-font-weight: bold; -fx-padding: 10 25; -fx-cursor: hand; -fx-font-size: 14px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 1);"/>
        <Button text="Registrar Producto" onAction="#guardarProducto" style="-fx-background-color: #06D6A0; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 25; -fx-cursor: hand; -fx-font-size: 14px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 8, 0, 0, 2);"/>
    </HBox>
</VBox>