<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="768.0" prefWidth="1126.0" style="-fx-background-color: #edf2f7;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.asm.controlador.PuntoVentaController">
    <children>

        <!-- Región Izquierda: Buscador y Catálogo de Prendas -->
        <BorderPane HBox.hgrow="ALWAYS">
            <top>
                <HBox alignment="CENTER_LEFT" prefHeight="80.0" BorderPane.alignment="CENTER">
                    <children>
                        <TextField fx:id="txtBuscarProducto" prefHeight="45.0" prefWidth="600.0" promptText="🔍 Buscar producto por nombre o SKU..." style="-fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-color: white;">
                            <font><Font size="16.0" /></font>
                        </TextField>
                    </children>
                    <padding><Insets left="30.0" right="30.0" top="20.0" /></padding>
                </HBox>
            </top>

            <center>
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #edf2f7;" BorderPane.alignment="CENTER">
                    <content>
                        <TilePane fx:id="contenedorProductos" hgap="20.0" vgap="20.0">
                            <padding>
                                <Insets bottom="30.0" left="30.0" right="30.0" top="10.0" />
                            </padding>
                        </TilePane>
                    </content>
                    <BorderPane.margin>
                        <Insets top="10.0" />
                    </BorderPane.margin>
                </ScrollPane>
            </center>
        </BorderPane>

        <!-- Región Derecha: Panel Lateral del Carrito de Compra Rescatado -->
        <!-- 🔥 MEJORA: Aumentamos el ancho de 360.0 a 400.0 para que entren bien los nombres y botones sin cortarse -->
        <VBox prefWidth="400.0" minWidth="380.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, -2, 0);">
            <children>
                <Label text="Carrito de Compra" textFill="#1e293b">
                    <font><Font name="System Bold" size="22.0" /></font>
                    <VBox.margin><Insets bottom="20.0" /></VBox.margin>
                </Label>

                <!-- Contenedor dinámico de elementos agregados -->
                <StackPane VBox.vgrow="ALWAYS">
                    <children>
                        <VBox fx:id="emptyStateCarrito" alignment="CENTER" spacing="10.0">
                            <children>
                                <Label text="🛒" textFill="#cbd5e1"><font><Font size="64.0" /></font></Label>
                                <Label text="No hay artículos" textFill="#94a3b8">
                                    <font><Font size="16.0" /></font>
                                </Label>
                            </children>
                        </VBox>
                        <!-- 🔥 MEJORA: Añadimos un scroll interno al carrito por si agregan muchas prendas -->
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: white;">
                            <content>
                                <VBox fx:id="contenedorCarrito" spacing="12.0" style="-fx-background-color: white;" />
                            </content>
                        </ScrollPane>
                    </children>
                </StackPane>

                <!-- Panel Inferior: Totales y Acciones Críticas -->
                <VBox spacing="15.0">
                    <children>
                        <HBox alignment="BOTTOM_LEFT">
                            <children>
                                <Label text="TOTAL:" textFill="#1e293b">
                                    <font><Font name="System Bold" size="24.0" /></font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblTotal" text="0.00" textFill="#10b981"> <!-- Color verde esmeralda para el dinero -->
                                    <font><Font name="System Bold" size="32.0" /></font>
                                </Label>
                            </children>
                        </HBox>

                        <Button fx:id="btnReimprimir" onAction="#abrirVentanaReimprimir" prefHeight="45.0" prefWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #a855f7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;" text="🖨️ Reimprimir Ticket" textFill="#a855f7">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>

                        <Button fx:id="btnProcesarPago" prefHeight="60.0" prefWidth="Infinity" style="-fx-background-color: #10b981; -fx-background-radius: 8; -fx-cursor: hand;" text="PROCESAR PAGO" textFill="WHITE">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Button>

                        <Button fx:id="btnCancelar" prefHeight="45.0" prefWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #e3342f; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;" text="Cancelar Venta" textFill="#e3342f" visible="false">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                </VBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="30.0" />
            </padding>
        </VBox>

    </children>
</HBox>