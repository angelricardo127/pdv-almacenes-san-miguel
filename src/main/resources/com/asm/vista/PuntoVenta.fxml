<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="768.0" prefWidth="1366.0" style="-fx-background-color: #edf2f7;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.asm.controlador.PuntoVentaController">

    <left>
        <VBox prefWidth="240.0" style="-fx-background-color: #2b3440;" BorderPane.alignment="CENTER">
            <children>
                <VBox alignment="CENTER_LEFT" prefHeight="100.0">
                    <children>
                        <Label text="ALMACENES" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Label text="SAN MIGUEL" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                    </children>
                    <VBox.margin>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </VBox.margin>
                </VBox>

                <Button alignment="BASELINE_LEFT" prefHeight="50.0" prefWidth="240.0" style="-fx-background-color: transparent;" text="  Dashboard" textFill="#a6adbb">
                    <font><Font size="16.0" /></font>
                    <padding><Insets left="30.0" /></padding>
                </Button>
                <Button alignment="BASELINE_LEFT" prefHeight="50.0" prefWidth="220.0" style="-fx-background-color: #1abc9c; -fx-background-radius: 0 25 25 0;" text="  Ventas" textFill="WHITE">
                    <font><Font name="System Bold" size="16.0" /></font>
                    <padding><Insets left="30.0" /></padding>
                    <VBox.margin><Insets right="20.0" /></VBox.margin>
                </Button>
                <Button alignment="BASELINE_LEFT" prefHeight="50.0" prefWidth="240.0" style="-fx-background-color: transparent;" text="  Inventario" textFill="#a6adbb">
                    <font><Font size="16.0" /></font>
                    <padding><Insets left="30.0" /></padding>
                </Button>
                <Button alignment="BASELINE_LEFT" prefHeight="50.0" prefWidth="240.0" style="-fx-background-color: transparent;" text="  Caja" textFill="#a6adbb">
                    <font><Font size="16.0" /></font>
                    <padding><Insets left="30.0" /></padding>
                </Button>
                <Button alignment="BASELINE_LEFT" prefHeight="50.0" prefWidth="240.0" style="-fx-background-color: transparent;" text="  Reportes" textFill="#a6adbb">
                    <font><Font size="16.0" /></font>
                    <padding><Insets left="30.0" /></padding>
                </Button>

                <Region VBox.vgrow="ALWAYS" />

                <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="10.0">
                    <children>
                        <Label style="-fx-background-color: #4b5563; -fx-background-radius: 15;" text=" 🧑‍💼 " textFill="WHITE">
                            <font><Font size="20.0" /></font>
                        </Label>
                        <VBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Roberto Sánchez" textFill="WHITE">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Label>
                                <Label text="Administrador" textFill="#a6adbb">
                                    <font><Font size="12.0" /></font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                    <padding><Insets left="20.0" /></padding>
                </HBox>

                <Button prefHeight="50.0" prefWidth="240.0" style="-fx-background-color: #e3342f; -fx-background-radius: 0;" text="Cerrar Sesión" textFill="WHITE">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
            </children>
        </VBox>
    </left>

    <center>
        <BorderPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <top>
                <HBox alignment="CENTER_LEFT" prefHeight="80.0" BorderPane.alignment="CENTER">
                    <children>
                        <TextField fx:id="campoBusqueda" prefHeight="45.0" prefWidth="600.0" promptText="🔍 Buscar producto por nombre o SKU..." style="-fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-color: white;">
                            <font><Font size="16.0" /></font>
                        </TextField>
                    </children>
                    <padding><Insets left="30.0" right="30.0" top="20.0" /></padding>
                </HBox>
            </top>

            <center>
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #edf2f7;" BorderPane.alignment="CENTER">
                    <content>
                        <TilePane fx:id="contenedorProductos" hgap="20.0" vgap="20.0">
                            <padding>
                                <Insets bottom="30.0" left="30.0" right="30.0" top="10.0" />
                            </padding>
                        </TilePane>
                    </content>
                    <BorderPane.margin>
                        <Insets top="10.0" />
                    </BorderPane.margin>
                </ScrollPane>
            </center>
        </BorderPane>
    </center>

    <right>
        <VBox prefWidth="360.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, -2, 0);" BorderPane.alignment="CENTER">
            <children>
                <Label text="Carrito de Compra" textFill="#1e293b">
                    <font><Font name="System Bold" size="20.0" /></font>
                    <VBox.margin><Insets bottom="20.0" /></VBox.margin>
                </Label>

                <StackPane VBox.vgrow="ALWAYS">
                    <children>
                        <VBox fx:id="emptyStateCarrito" alignment="CENTER" spacing="10.0">
                            <children>
                                <Label text="🛒" textFill="#cbd5e1"><font><Font size="64.0" /></font></Label>
                                <Label text="No hay artículos" textFill="#94a3b8">
                                    <font><Font size="16.0" /></font>
                                </Label>
                            </children>
                        </VBox>
                  <VBox fx:id="contenedorCarrito" prefHeight="200.0" prefWidth="100.0" />
                    </children>
                </StackPane>

                <VBox spacing="15.0">
                    <children>
                        <HBox alignment="BOTTOM_LEFT">
                            <children>
                                <Label text="TOTAL:" textFill="#1e293b">
                                    <font><Font name="System Bold" size="24.0" /></font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblTotal" text="\$0.00" textFill="#94a3b8">
                                    <font><Font name="System Bold" size="30.0" /></font>
                                </Label>
                            </children>
                        </HBox>

                        <Button fx:id="btnReimprimir" prefHeight="45.0" prefWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #a855f7; -fx-border-radius: 8; -fx-background-radius: 8;" text="🖨️ Reimprimir Ticket" textFill="#a855f7">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>

                        <Button fx:id="btnProcesarPago" prefHeight="60.0" prefWidth="Infinity" style="-fx-background-color: #e2e8f0; -fx-background-radius: 8;" text="PROCESAR PAGO (F12)" textFill="#64748b">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Button>

                        <Button fx:id="btnCancelar" prefHeight="45.0" prefWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #e3342f; -fx-border-radius: 8; -fx-background-radius: 8;" text="Cancelar Venta" textFill="#e3342f" visible="false">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                </VBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="30.0" />
            </padding>
        </VBox>
    </right>
</BorderPane>
