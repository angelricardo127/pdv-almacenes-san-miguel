<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="principalPane" prefHeight="768.0" prefWidth="1366.0" style="-fx-background-color: #f3f4f6;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.asm.controlador.ContenedorBaseController">

    <left>
        <VBox prefHeight="768.0" prefWidth="240.0" style="-fx-background-color: #2b3543;" BorderPane.alignment="CENTER">
            <children>
                <Label text="ALMACENES&#10;SAN MIGUEL" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="30.0" left="20.0" top="30.0" />
                    </VBox.margin>
                </Label>

                <Button fx:id="btnDashboard" onAction="#mostrarDashboard" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: #10b981; -fx-alignment: BASELINE_LEFT; -fx-background-radius: 8; -fx-cursor: hand;" text="⊞   Dashboard" textFill="WHITE">
                    <font><Font name="System Bold" size="14.0" /></font>
                    <VBox.margin><Insets bottom="5.0" left="10.0" right="10.0" /></VBox.margin>
                    <padding><Insets left="15.0" /></padding>
                </Button>

                <Button fx:id="btnVentas" onAction="#mostrarVentas" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand;" text="🛒   Ventas" textFill="#9ca3af">
                    <font><Font size="14.0" /></font>
                    <VBox.margin><Insets bottom="5.0" left="10.0" right="10.0" /></VBox.margin>
                    <padding><Insets left="15.0" /></padding>
                </Button>

                <Button fx:id="btnInventario" onAction="#mostrarInventario" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand;" text="📦   Inventario" textFill="#9ca3af">
                    <font><Font size="14.0" /></font>
                    <VBox.margin><Insets bottom="5.0" left="10.0" right="10.0" /></VBox.margin>
                    <padding><Insets left="15.0" /></padding>
                </Button>

                <Button fx:id="btnCaja" onAction="#mostrarCaja" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand;" text="💰   Caja" textFill="#9ca3af">
                    <font><Font size="14.0" /></font>
                    <VBox.margin><Insets bottom="5.0" left="10.0" right="10.0" /></VBox.margin>
                    <padding><Insets left="15.0" /></padding>
                </Button>

                <Button fx:id="btnCambios" onAction="#mostrarCambios" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand;" text="🔄   Cambios" textFill="#9ca3af">
                    <font><Font size="14.0" /></font>
                    <VBox.margin><Insets bottom="5.0" left="10.0" right="10.0" /></VBox.margin>
                    <padding><Insets left="15.0" /></padding>
                </Button>

                <Button fx:id="btnReportes" onAction="#mostrarReportes" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand;" text="📊   Reportes" textFill="#9ca3af">
                    <font><Font size="14.0" /></font>
                    <VBox.margin><Insets bottom="5.0" left="10.0" right="10.0" /></VBox.margin>
                    <padding><Insets left="15.0" /></padding>
                </Button>

                <Button fx:id="btnSeguridad" onAction="#mostrarSeguridad" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand;" text="🛡️   Seguridad" textFill="#9ca3af">
                    <font><Font size="14.0" /></font>
                    <VBox.margin><Insets bottom="5.0" left="10.0" right="10.0" /></VBox.margin>
                    <padding><Insets left="15.0" /></padding>
                </Button>

                <Region VBox.vgrow="ALWAYS" />

                <VBox>
                    <children>
                        <Label fx:id="lblNombreUsuario" text="👤 Cargando..." textFill="WHITE">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Label>

                        <Label fx:id="lblRolUsuario" text="Cargando..." textFill="#9ca3af">
                            <font><Font size="11.0" /></font>
                            <padding><Insets left="20.0" /></padding>
                        </Label>

                        <Button onAction="#cerrarSesion" mnemonicParsing="false" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #ff0000; -fx-background-radius: 8; -fx-cursor: hand; -fx-alignment: CENTER;" text="[→ Cerrar Sesión" textFill="WHITE">
                            <font><Font name="System Bold" size="14.0" /></font>
                            <VBox.margin><Insets top="15.0" /></VBox.margin>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets bottom="30.0" left="20.0" />
                    </VBox.margin>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="areaTrabajo" style="-fx-background-color: transparent;" BorderPane.alignment="CENTER" />
    </center>

</BorderPane>