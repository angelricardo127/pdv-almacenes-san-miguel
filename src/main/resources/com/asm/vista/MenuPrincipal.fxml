<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="768.0" prefWidth="1366.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.asm.controlador.MenuPrincipalController">

    <!-- BARRA LATERAL FIJA -->
    <VBox prefWidth="250.0" style="-fx-background-color: #2c3e50;">
        <padding>
            <Insets top="30" bottom="0" left="0" right="0"/>
        </padding>

        <Label text="ALMACENES&#10;SAN MIGUEL" textFill="WHITE">
            <font><Font name="System Bold" size="20.0" /></font>
            <VBox.margin><Insets bottom="40.0" left="25.0" /></VBox.margin>
        </Label>

        <!-- Botones con su fx:id correspondiente -->
        <Button fx:id="btnDashboard" alignment="BASELINE_LEFT" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-cursor: hand;" text="  Dashboard">
            <padding><Insets bottom="15.0" left="30.0" top="15.0" /></padding>
            <font><Font size="14.0" /></font>
        </Button>
        <Button fx:id="btnVentas" alignment="BASELINE_LEFT" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-cursor: hand;" text="  Ventas">
            <padding><Insets bottom="15.0" left="30.0" top="15.0" /></padding>
            <font><Font size="14.0" /></font>
        </Button>
        <Button fx:id="btnInventario" alignment="BASELINE_LEFT" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-cursor: hand;" text="  Inventario">
            <padding><Insets bottom="15.0" left="30.0" top="15.0" /></padding>
            <font><Font size="14.0" /></font>
        </Button>
        <Button fx:id="btnSeguridad" alignment="BASELINE_LEFT" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-cursor: hand;" text="  Seguridad">
            <padding><Insets bottom="15.0" left="30.0" top="15.0" /></padding>
            <font><Font size="14.0" /></font>
        </Button>

        <Region VBox.vgrow="ALWAYS" />

        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #34495e;">
            <padding><Insets bottom="20.0" left="25.0" right="20.0" top="20.0" /></padding>
            <Label style="-fx-background-color: #7f8c8d; -fx-background-radius: 50; -fx-min-width: 35; -fx-min-height: 35; -fx-alignment: center;" text="👨‍💼" />
            <VBox alignment="CENTER_LEFT">
                <Label text="Roberto Sánchez" textFill="WHITE"><font><Font name="System Bold" size="13.0" /></font></Label>
                <Label text="Administrador" textFill="#bdc3c7"><font><Font size="11.0" /></font></Label>
            </VBox>
        </HBox>
    </VBox>

    <!-- CONTENEDOR DINÁMICO (Aquí se inyectará cada módulo) -->
    <VBox fx:id="contenedorPrincipal" style="-fx-background-color: #f4f6f9;" HBox.hgrow="ALWAYS" />

</HBox>
