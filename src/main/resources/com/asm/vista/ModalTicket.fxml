<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="450.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.asm.controlador.ModalTicketController">
    <children>
        <VBox layoutX="10.0" layoutY="10.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5);" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="Ticket de Venta" textFill="#2c3e50">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <AnchorPane HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnCerrarX" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-cursor: hand;" text="✕" textFill="#7f8c8d">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <VBox style="-fx-border-color: #bdc3c7; -fx-border-style: dashed; -fx-border-width: 2; -fx-background-color: #ffffff; -fx-border-radius: 5;">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <VBox alignment="CENTER" spacing="2.0">
                            <children>
                                <Label text="ALMACENES SAN MIGUEL">
                                    <font>
                                        <Font name="Monospaced Bold" size="16.0" />
                                    </font>
                                </Label>
                                <Label text="Uniformes Escolares">
                                    <font>
                                        <Font name="Monospaced Regular" size="12.0" />
                                    </font>
                                </Label>
                                <Label text="RFC: ASM123456ABC">
                                    <font>
                                        <Font name="Monospaced Regular" size="12.0" />
                                    </font>
                                </Label>
                                <Label text="Tel: (555) 123 4567">
                                    <font>
                                        <Font name="Monospaced Regular" size="12.0" />
                                    </font>
                                </Label>
                            </children>
                            <VBox.margin>
                                <Insets bottom="15.0" />
                            </VBox.margin>
                        </VBox>

                        <HBox>
                            <children>
                                <Label text="TICKET:">
                                    <font>
                                        <Font name="Monospaced Bold" size="12.0" />
                                    </font>
                                </Label>
                                <AnchorPane HBox.hgrow="ALWAYS" />
                                <Label text="#7923">
                                    <font>
                                        <Font name="Monospaced Regular" size="12.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                        <HBox>
                            <children>
                                <Label text="FECHA:">
                                    <font>
                                        <Font name="Monospaced Bold" size="12.0" />
                                    </font>
                                </Label>
                                <AnchorPane HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblFechaHora" text="25/05/2026 01:31 p.m.">
                                    <font>
                                        <Font name="Monospaced Regular" size="12.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                        <HBox>
                            <children>
                                <Label text="CAJERO:">
                                    <font>
                                        <Font name="Monospaced Bold" size="12.0" />
                                    </font>
                                </Label>
                                <AnchorPane HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblCajeroTicket" text="Cajero General">
                                    <font>
                                        <Font name="Monospaced Regular" size="12.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>

                        <Line endX="200.0" stroke="#bdc3c7" strokeDashArray="4, 4">
                            <VBox.margin>
                                <Insets bottom="10.0" top="10.0" />
                            </VBox.margin>
                        </Line>

                        <Label text="ARTÍCULOS:">
                            <font>
                                <Font name="Monospaced Bold" size="12.0" />
                            </font>
                            <VBox.margin>
                                <Insets bottom="5.0" />
                            </VBox.margin>
                        </Label>

                        <VBox fx:id="vboxListaArticulos" spacing="5.0">
                        </VBox>

                        <Line endX="200.0" stroke="#bdc3c7" strokeDashArray="4, 4">
                            <VBox.margin>
                                <Insets bottom="10.0" top="10.0" />
                            </VBox.margin>
                        </Line>

                        <HBox>
                            <children>
                                <Label text="SUBTOTAL :">
                                    <font>
                                        <Font name="Monospaced Bold" size="12.0" />
                                    </font>
                                </Label>
                                <AnchorPane HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblSubtotalTicket" text="\$0.00">
                                    <font>
                                        <Font name="Monospaced Regular" size="12.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                        <HBox>
                            <children>
                                <Label text="TOTAL :">
                                    <font>
                                        <Font name="Monospaced Bold" size="16.0" />
                                    </font>
                                </Label>
                                <AnchorPane HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblTotalTicket" text="\$0.00">
                                    <font>
                                        <Font name="Monospaced Bold" size="16.0" />
                                    </font>
                                </Label>
                            </children>
                            <VBox.margin>
                                <Insets bottom="10.0" top="5.0" />
                            </VBox.margin>
                        </HBox>

                        <HBox>
                            <children>
                                <Label text="MÉTODO DE PAGO:">
                                    <font>
                                        <Font name="Monospaced Bold" size="12.0" />
                                    </font>
                                </Label>
                                <AnchorPane HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblMetodoPagoTicket" text="Efectivo">
                                    <font>
                                        <Font name="Monospaced Regular" size="12.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                        <HBox>
                            <children>
                                <Label text="Recibido:">
                                    <font>
                                        <Font name="Monospaced Regular" size="12.0" />
                                    </font>
                                </Label>
                                <AnchorPane HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblRecibidoTicket" text="\$0.00">
                                    <font>
                                        <Font name="Monospaced Regular" size="12.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                        <HBox>
                            <children>
                                <Label text="Cambio:">
                                    <font>
                                        <Font name="Monospaced Bold" size="12.0" />
                                    </font>
                                </Label>
                                <AnchorPane HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblCambioTicket" text="\$0.00">
                                    <font>
                                        <Font name="Monospaced Bold" size="12.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>

                        <VBox alignment="CENTER" spacing="5.0">
                            <children>
                                <Label text="¡Gracias por su compra!">
                                    <font>
                                        <Font name="Monospaced Regular" size="10.0" />
                                    </font>
                                </Label>
                                <Label text="Vuelva pronto">
                                    <font>
                                        <Font name="Monospaced Regular" size="10.0" />
                                    </font>
                                </Label>
                            </children>
                            <VBox.margin>
                                <Insets top="20.0" />
                            </VBox.margin>
                        </VBox>
                    </children>
                </VBox>

                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnCerrar" mnemonicParsing="false" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="Cerrar" textFill="#7f8c8d">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnGenerarTicket" mnemonicParsing="false" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: #1abc9c; -fx-background-radius: 6; -fx-cursor: hand;" text="🖨 Generar Ticket" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets top="5.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>