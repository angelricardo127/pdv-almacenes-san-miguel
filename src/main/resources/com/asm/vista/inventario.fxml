<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.FontWeight?>

<VBox prefHeight="768.0" prefWidth="1126.0" spacing="25.0" style="-fx-padding: 30; -fx-background-color: #F4F6F8; -fx-font-family: 'Segoe UI', sans-serif;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.asm.controlador.InventarioController">

    <HBox alignment="BOTTOM_LEFT" spacing="20.0">

        <VBox HBox.hgrow="ALWAYS">
            <Label text="Gestión de Inventario" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2D3748;"/>
            <Label fx:id="lblBienvenida" text="Bienvenido, Roberto Sánchez Pérez • lunes, 25 de mayo de 2026" textFill="#6b7280" />
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <Button text="⚠️ Ajuste de Stock" onAction="#abrirAjusteStock"  style="-fx-background-color: #FF5A1F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 15; -fx-cursor: hand;"/>
            <Button text="✏️ Gestión de Variantes" onAction="#abrirGestionVariantes" style="-fx-background-color: #A825FF; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 15; -fx-cursor: hand;"/>
            <Button fx:id="btnRegistrarNuevo" onAction="#abrirFormularioRegistro" text="📦 Registrar Nuevo Producto" style="-fx-background-color: #06D6A0; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 15; -fx-cursor: hand;"/>
        </HBox>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 12 15;">
        <Label text="🔍" style="-fx-text-fill: #A0AEC0; -fx-font-size: 16px;"/>
        <TextField promptText="Buscar por SKU, producto o categoría..." style="-fx-background-color: transparent; -fx-font-size: 14px; -fx-prompt-text-fill: #A0AEC0;" HBox.hgrow="ALWAYS"/>
    </HBox>

    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 4); -fx-padding: 5;" VBox.vgrow="ALWAYS">

        <TableView fx:id="tablaInventario" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colSku" text="SKU" prefWidth="110" style="-fx-alignment: CENTER-LEFT; -fx-font-weight: bold;"/>
                <TableColumn fx:id="colProducto" text="Producto" prefWidth="250" style="-fx-alignment: CENTER-LEFT;"/>
                <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="130" style="-fx-alignment: CENTER-LEFT;"/>
                <TableColumn fx:id="colVariantes" text="Variantes" prefWidth="150" style="-fx-alignment: CENTER-LEFT;"/>
                <TableColumn fx:id="colPrecio" text="Precio" prefWidth="100" style="-fx-alignment: CENTER-LEFT; -fx-font-weight: bold;"/>
                <TableColumn fx:id="colStock" text="Stock" prefWidth="80" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="120" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="160" style="-fx-alignment: CENTER;"/>
            </columns>
        </TableView>
    </VBox>
</VBox>