<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.FontWeight?>

<BorderPane prefHeight="768.0" prefWidth="1366.0" style="-fx-background-color: #F4F6F8; -fx-font-family: 'Segoe UI', sans-serif;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.asm.controlador.InventarioController">

    <left>
        <VBox prefWidth="240.0" style="-fx-background-color: #2D3748; -fx-padding: 30 15 20 15;">

            <Label text="ALMACENES&#10;SAN MIGUEL" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;">
                <VBox.margin>
                    <Insets bottom="40.0" />
                </VBox.margin>
            </Label>

            <VBox spacing="5.0">
                <Label text="    Dashboard" style="-fx-text-fill: #A0AEC0; -fx-font-size: 14px; -fx-padding: 10 15; -fx-cursor: hand;"/>
                <Label text="    Ventas" style="-fx-text-fill: #A0AEC0; -fx-font-size: 14px; -fx-padding: 10 15; -fx-cursor: hand;"/>
                <Label text="    Inventario" style="-fx-background-color: #06D6A0; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 15; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Label text="    Caja" style="-fx-text-fill: #A0AEC0; -fx-font-size: 14px; -fx-padding: 10 15; -fx-cursor: hand;"/>
                <Label text="    Cambios" style="-fx-text-fill: #A0AEC0; -fx-font-size: 14px; -fx-padding: 10 15; -fx-cursor: hand;"/>
                <Label text="    Reportes" style="-fx-text-fill: #A0AEC0; -fx-font-size: 14px; -fx-padding: 10 15; -fx-cursor: hand;"/>
                <Label text="    Seguridad" style="-fx-text-fill: #A0AEC0; -fx-font-size: 14px; -fx-padding: 10 15; -fx-cursor: hand;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <VBox spacing="15.0" style="-fx-border-color: rgba(255,255,255,0.1) transparent transparent transparent; -fx-border-width: 1 0 0 0; -fx-padding: 20 0 0 0;">

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label style="-fx-background-color: #4A5568; -fx-text-fill: white; -fx-background-radius: 50%; -fx-min-width: 35; -fx-min-height: 35; -fx-alignment: center; -fx-font-weight: bold;" text="R" />
                    <VBox>
                        <Label text="Roberto Sánchez Pé..." style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <Label text="Administrador" style="-fx-text-fill: #A0AEC0; -fx-font-size: 11px;"/>
                    </VBox>
                </HBox>

                <Button text="[→ Cerrar Sesión" style="-fx-background-color: transparent; -fx-text-fill: #FF4D4D; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0;"/>
            </VBox>

        </VBox>
    </left>

    <center>
        <VBox spacing="25.0" style="-fx-padding: 30;">

            <HBox alignment="BOTTOM_LEFT" spacing="20.0">

                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Gestión de Inventario" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2D3748;"/>
                    <Label text="Bienvenido, Roberto Sánchez Pérez • lunes, 25 de mayo de 2026" style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                    <Button text="⚠️ Ajuste de Stock"  style="-fx-background-color: #FF5A1F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 15; -fx-cursor: hand;"/>
                    <Button text="✏️ Gestión de Variantes" style="-fx-background-color: #A825FF; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 15; -fx-cursor: hand;"/>
                    <Button text="⚠ Ajuste de Stock" onAction="#abrirAjusteStock" style="-fx-background-color: #FF5A1F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 15; -fx-cursor: hand; "/>
                    <Button text="✏ Gestión de Variantes" style="-fx-background-color: #A825FF; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 15; -fx-cursor: hand;"/>
                    <Button fx:id="btnRegistrarNuevo" onAction="#abrirFormularioRegistro" text="📦 Registrar Nuevo Producto" style="-fx-background-color: #06D6A0; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 15; -fx-cursor: hand;"/>
                    <Button text="[→ Salir" style="-fx-background-color: white; -fx-border-color: #FF4D4D; -fx-border-radius: 8; -fx-text-fill: #FF4D4D; -fx-font-weight: bold; -fx-padding: 9 15; -fx-cursor: hand;"/>
                </HBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 12 15;">
                <Label text="🔍" style="-fx-text-fill: #A0AEC0; -fx-font-size: 16px;"/>
                <TextField promptText="Buscar por SKU, producto o categoría..." style="-fx-background-color: transparent; -fx-font-size: 14px; -fx-prompt-text-fill: #A0AEC0;" HBox.hgrow="ALWAYS"/>
            </HBox>

            <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 4); -fx-padding: 5;" VBox.vgrow="ALWAYS">

                <TableView fx:id="tablaInventario" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSku" text="SKU" prefWidth="110" style="-fx-alignment: CENTER-LEFT; -fx-font-weight: bold;"/>
                        <TableColumn fx:id="colProducto" text="Producto" prefWidth="250" style="-fx-alignment: CENTER-LEFT;"/>
                        <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="130" style="-fx-alignment: CENTER-LEFT;"/>
                        <TableColumn fx:id="colVariantes" text="Variantes" prefWidth="150" style="-fx-alignment: CENTER-LEFT;"/>
                        <TableColumn fx:id="colPrecio" text="Precio" prefWidth="100" style="-fx-alignment: CENTER-LEFT; -fx-font-weight: bold;"/>
                        <TableColumn fx:id="colStock" text="Stock" prefWidth="80" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="120" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="160" style="-fx-alignment: CENTER;"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>