<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="768.0" prefWidth="1126.0" spacing="25.0" style="-fx-padding: 30; -fx-background-color: #F4F6F8; -fx-font-family: 'Segoe UI', sans-serif;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.asm.controlador.InventarioController">

    <HBox alignment="BOTTOM_LEFT" spacing="20.0">

        <VBox HBox.hgrow="ALWAYS">
            <Label text="Gestión de Inventario" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2D3748;"/>
            <Label fx:id="lblBienvenida" text="Bienvenido, Roberto Sánchez Pérez • lunes, 25 de mayo de 2026" textFill="#6b7280" />
            <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2D3748;" text="Gestión de Inventario" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #718096;" text="Bienvenido, Roberto Sánchez Pérez • lunes, 25 de mayo de 2026" />
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <Button onAction="#abrirAjusteStock" style="-fx-background-color: #FF5A1F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 15; -fx-cursor: hand;" text="⚠️ Ajuste de Stock" />
            <Button onAction="#abrirGestionVariantes" style="-fx-background-color: #A825FF; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 15; -fx-cursor: hand;" text="✏️ Gestión de Variantes" />
            <Button fx:id="btnRegistrarNuevo" onAction="#abrirFormularioRegistro" style="-fx-background-color: #06D6A0; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 15; -fx-cursor: hand;" text="📦 Registrar Nuevo Producto" />
        </HBox>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 12 15;">
        <Label style="-fx-text-fill: #A0AEC0; -fx-font-size: 16px;" text="🔍" />
        <TextField fx:id="txtBuscador" promptText="Buscar por SKU, producto o categoría..." style="-fx-background-color: transparent; -fx-font-size: 14px; -fx-prompt-text-fill: #A0AEC0;" HBox.hgrow="ALWAYS" />
    </HBox>

    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 4); -fx-padding: 5;" VBox.vgrow="ALWAYS">

        <TableView fx:id="tablaInventario" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colSku" prefWidth="110" style="-fx-alignment: CENTER-LEFT; -fx-font-weight: bold;" text="SKU" />
                <TableColumn fx:id="colProducto" prefWidth="250" style="-fx-alignment: CENTER-LEFT;" text="Producto" />
                <TableColumn fx:id="colCategoria" prefWidth="130" style="-fx-alignment: CENTER-LEFT;" text="Categoría" />
                <TableColumn fx:id="colVariantes" prefWidth="150" style="-fx-alignment: CENTER-LEFT;" text="Variantes" />
                <TableColumn fx:id="colPrecio" prefWidth="100" style="-fx-alignment: CENTER-LEFT; -fx-font-weight: bold;" text="Precio" />
                <TableColumn fx:id="colStock" prefWidth="80" style="-fx-alignment: CENTER; -fx-font-weight: bold;" text="Stock" />
                <TableColumn fx:id="colEstado" prefWidth="120" style="-fx-alignment: CENTER;" text="Estado" />
                <TableColumn fx:id="colAcciones" prefWidth="160" style="-fx-alignment: CENTER;" text="Acciones" />
            </columns>
        </TableView>
    </VBox>
</VBox>
