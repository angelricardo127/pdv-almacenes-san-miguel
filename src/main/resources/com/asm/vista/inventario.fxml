<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f4f6f8;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.asm.controlador.InventarioController">

    <top>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="30.0" right="30.0" top="30.0" />
            </padding>

            <Label text="Gestión de Almacén e Inventario" textFill="#2c3e50">
                <font>
                    <Font name="System Bold" size="24.0" />
                </font>
            </Label>

            <HBox spacing="10.0">
                <TextField fx:id="txtNombreProducto" prefWidth="250.0" promptText="Nombre del Producto" style="-fx-font-size: 14px;" />
                <TextField fx:id="txtPrecio" prefWidth="100.0" promptText="Precio ($)" style="-fx-font-size: 14px;" />
                <TextField fx:id="txtStock" prefWidth="100.0" promptText="Stock Inicial" style="-fx-font-size: 14px;" />
                <TextField fx:id="txtIdTalla" prefWidth="80.0" promptText="ID Talla" style="-fx-font-size: 14px;" />
                <TextField fx:id="txtIdGenero" prefWidth="80.0" promptText="ID Género" style="-fx-font-size: 14px;" />

                <Button fx:id="btnGuardarProducto" mnemonicParsing="false" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;" text="Guardar Producto">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-control-inner-background: transparent;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="30.0" right="30.0" top="10.0" />
            </padding>
            <content>
                <TilePane fx:id="contenedorCatalogo" hgap="20.0" vgap="20.0" />
            </content>
        </ScrollPane>
    </center>

</BorderPane>