<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="768.0" prefWidth="1126.0" spacing="20.0" style="-fx-background-color: #f3f4f6;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.asm.controlador.InventarioController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <VBox>
            <Label text="Gestión de Inventario" textFill="#1f2937">
                <font>
                    <Font name="System Bold" size="32.0" />
                </font>
            </Label>
            <Label fx:id="lblBienvenida" text="Cargando usuario activo..." textFill="#6b7280">
                <font>
                    <Font size="14.0" />
                </font>
            </Label>
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <Button mnemonicParsing="false" onAction="#abrirAjusteStock" style="-fx-background-color: #f97316; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="⚠️ Ajuste de Stock">
            <padding>
                <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
            </padding>
        </Button>
        <Button mnemonicParsing="false" onAction="#abrirGestionVariantes" style="-fx-background-color: #a855f7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="🔗 Gestión de Variantes">
            <padding>
                <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
            </padding>
            <HBox.margin>
                <Insets left="10.0" right="10.0" />
            </HBox.margin>
        </Button>
        <Button fx:id="btnRegistrarNuevo" mnemonicParsing="false" onAction="#abrirFormularioRegistro" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="➕ Registrar Nuevo Producto">
            <padding>
                <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
            </padding>
        </Button>
    </HBox>

    <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-radius: 8;">
        <padding>
            <Insets bottom="5.0" left="15.0" right="15.0" top="5.0" />
        </padding>
        <Label text="🔍" textFill="#9ca3af" />
        <TextField fx:id="txtBuscador" promptText="Buscar por SKU, producto o categoría..." style="-fx-background-color: transparent;" HBox.hgrow="ALWAYS">
            <font>
                <Font size="14.0" />
            </font>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </TextField>
    </HBox>

    <TableView fx:id="tablaInventario" style="-fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-color: white;" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colSku" prefWidth="130.0" text="SKU" />
            <TableColumn fx:id="colProducto" prefWidth="250.0" text="Producto" />
            <TableColumn fx:id="colCategoria" prefWidth="150.0" text="Categoría" />
            <TableColumn fx:id="colVariantes" prefWidth="100.0" text="Variantes" />
            <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio" />
            <TableColumn fx:id="colStock" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Stock" />
            <TableColumn fx:id="colEstado" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Estado" />
            <TableColumn fx:id="colAcciones" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Acciones" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>
