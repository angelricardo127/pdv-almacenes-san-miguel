<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="530.0" prefWidth="430.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.asm.controlador.ModalPagoController">
    <children>
        <VBox layoutX="10.0" layoutY="10.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5);" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="Procesar Pago" textFill="#2c3e50">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <AnchorPane HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnCerrar" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-cursor: hand;" text="✕" textFill="#7f8c8d">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f8fdfb; -fx-background-radius: 8;">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                        <VBox spacing="3.0">
                            <children>
                                <Label text="Total a Pagar:" textFill="#34495e">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <Label text="Artículos en el carrito" textFill="#95a5a6">
                                    <font>
                                        <Font size="11.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                        <AnchorPane HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTotalPagar" text="\$0.00" textFill="#1abc9c">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <VBox spacing="8.0">
                    <children>
                        <Label text="Método de Pago *" textFill="#34495e">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                        <HBox spacing="10.0">
                            <children>
                                <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: #ebfaf4; -fx-border-color: #1abc9c; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="💵 Efectivo" textFill="#1abc9c">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Button>
                                <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="💳 Tarjeta" textFill="#7f8c8d">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="8.0">
                    <children>
                        <Label text="Monto Recibido" textFill="#34495e">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtMontoRecibido" prefHeight="45.0" promptText="\$ 0.00" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-background-radius: 6;">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </TextField>
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f0f4fa; -fx-background-radius: 8; -fx-border-color: #d5e0f2; -fx-border-radius: 8;">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                        <Label text="Cambio a Entregar:" textFill="#34495e">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <AnchorPane HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblCambio" text="\$0.00" textFill="#2980b9">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnCancelar" mnemonicParsing="false" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="Cancelar" textFill="#7f8c8d">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnConfirmarPago" mnemonicParsing="false" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: #1abc9c; -fx-background-radius: 6; -fx-cursor: hand;" text="Confirmar Pago (Enter)" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>