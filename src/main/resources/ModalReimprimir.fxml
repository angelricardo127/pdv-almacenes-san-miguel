<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="380.0" prefWidth="450.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.asm.controlador.ModalReimprimirController">
    <children>
        <VBox layoutX="10.0" layoutY="10.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5);" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="Reimprimir Ticket" textFill="#2c3e50">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <AnchorPane HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnCerrarX" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-cursor: hand;" text="✕" textFill="#7f8c8d">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <VBox spacing="8.0">
                    <children>
                        <Label text="Número de Folio del Ticket *" textFill="#34495e">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtFolioTicket" prefHeight="40.0" promptText="Ej: 1001" style="-fx-background-color: white; -fx-border-color: #9d00ff; -fx-border-radius: 6; -fx-background-radius: 6;">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </TextField>
                        <Label text="💡 Ingrese el número de folio del ticket que desea reimprimir" textFill="#7f8c8d">
                            <font>
                                <Font size="11.0" />
                            </font>
                        </Label>
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </VBox>

                <VBox style="-fx-background-color: #f0f7ff; -fx-border-color: #cce3ff; -fx-border-radius: 6; -fx-background-radius: 6;">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                        <Label text="Tickets disponibles: #1001, #1002, #1003, #1004,&#10;#1005, #1006" textFill="#0056b3" wrapText="true">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" top="5.0" />
                    </VBox.margin>
                </VBox>

                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnCancelar" mnemonicParsing="false" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="Cancelar" textFill="#7f8c8d">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnReimprimir" mnemonicParsing="false" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: #9d00ff; -fx-background-radius: 6; -fx-cursor: hand;" text="Buscar y&#10;Reimprimir" textAlignment="CENTER" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets top="5.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>